# Copia este archivo a .env y rellénalo (ver docs/supabase.md). .env nunca se sube al repo.
# Las dos son públicas por diseño: solo permiten lo que dejan las políticas RLS.

# Supabase → Project Settings → API → Project URL
PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
# Supabase → Project Settings → API Keys → anon (o la "publishable key", sb_publishable_...)
PUBLIC_SUPABASE_ANON_KEY=

# Solo para functions/api/publicar.ts. Van como *secret* de Cloudflare Pages, nunca con prefijo PUBLIC_
# ni en el repo. En local (wrangler pages dev) irían en .dev.vars, que tampoco se sube.
# Supabase → Project Settings → API Keys → service_role (o la "secret key", sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare → Workers & Pages → tu proyecto → Settings → Builds → Deploy hooks
CF_DEPLOY_HOOK_URL=

# Alertas de precio (docs/alertas.md). Cloudflare → Turnstile → tu widget.
# La site key es pública (va en el HTML); sin ella el formulario se muestra pero no puede enviarse.
PUBLIC_TURNSTILE_SITE_KEY=
# Secretos de Cloudflare Pages para functions/api/alertas y publicar (en local, .dev.vars):
TURNSTILE_SECRET_KEY=
# Brevo → SMTP & API → API Keys
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders, Domains & Dedicated IPs)
BREVO_SENDER_EMAIL=
