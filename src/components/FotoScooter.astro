---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  foto: ImageMetadata | null;
  nombre: string;
  /** Anchos (px) que se generan para el srcset. */
  widths: number[];
  sizes: string;
  /** Foto principal de la página: se carga con prioridad, no en diferido. */
  principal?: boolean;
  /** Miniatura: el placeholder muestra solo el icono. */
  compacta?: boolean;
  class?: string;
}
const { foto, nombre, widths, sizes, principal = false, compacta = false, class: clase = '' } = Astro.props;
---

{
  foto ? (
    // Fotos del fabricante con fondo blanco: multiply funde ese blanco con la placa (blanca en claro, crema en oscuro).
    <div class:list={['isolate overflow-hidden bg-surface dark:bg-fg', clase]}>
      <Picture
        src={foto}
        alt={`Scooter eléctrico ${nombre}, foto del fabricante`}
        widths={widths}
        sizes={sizes}
        formats={['avif']}
        fallbackFormat="webp"
        priority={principal}
        class="size-full object-contain mix-blend-multiply"
      />
    </div>
  ) : (
    <div class:list={['grid place-items-center bg-surface-2 text-muted', clase]} role="img" aria-label={`Foto de ${nombre} pendiente`}>
      <div class="grid justify-items-center gap-2">
        <Icon name="zap" class={compacta ? 'size-6' : 'size-12'} />
        {!compacta && <span class="label">Foto pendiente</span>}
      </div>
    </div>
  )
}
