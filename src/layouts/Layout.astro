---
import '@fontsource/archivo-black';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from '../components/Icon.astro';
import AlertaPopup from '../components/AlertaPopup.astro';
import { SITE, NAV } from '../config';

export type Miga = { nombre: string; ruta: string };

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Migas después de "Inicio". Por defecto, solo la página actual. */
  migas?: Miga[];
  /** Datos estructurados extra (schema.org), además del BreadcrumbList. */
  jsonLd?: Record<string, unknown>[];
  /** Imagen de vista previa al compartir (og:image). Sin ella, /og.png. */
  imagen?: { foto: ImageMetadata; alt: string };
}
const { title, description = SITE.description, noindex = false, migas, jsonLd = [], imagen } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · Compara scooters eléctricos en México`;
const path = Astro.url.pathname;
// Misma forma que las URLs del sitemap (build.format 'directory': con barra final).
const absoluta = (ruta: string) => new URL(ruta.endsWith('/') ? ruta : `${ruta}/`, Astro.site).href;
const canonical = absoluta(path);
// JPEG porque WhatsApp y Facebook no siempre aceptan WebP. Proporción original: con fit="contain" el servicio
// sharp no rellena hasta 1200×630 (reduce a 630×630) y "cover" recortaría el scooter.
const foto = imagen && (await getImage({ src: imagen.foto, width: Math.min(1200, imagen.foto.width), format: 'jpeg', background: '#fff' }));
const og = foto
  ? { src: new URL(foto.src, Astro.site).href, width: foto.attributes.width, height: foto.attributes.height, alt: imagen!.alt }
  : { src: new URL('/og.png', Astro.site).href, width: 1200, height: 630, alt: 'Compara scooters eléctricos en México: precio verificado y autonomía real' };

const todasLasMigas = [{ nombre: 'Inicio', ruta: '/' }, ...(migas ?? (path === '/' ? [] : [{ nombre: title ?? SITE.name, ruta: path }]))];
const datos = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: todasLasMigas.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.nombre, item: absoluta(m.ruta) })),
  },
  ...jsonLd,
];
// set:html con el JSON escapado: cada "<" va como escape unicode para que ningún texto cierre el <script>.
const ld = (d: Record<string, unknown>) => JSON.stringify(d).replace(/</g, '\u003c');
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && path !== '/404' && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og.src} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og.src} />
    {datos.map((d) => <script type="application/ld+json" set:html={ld(d)} />)}
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2efe9" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Apply the saved theme before paint to avoid a flash.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip">
    <a href="#main" class="btn btn-accent sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50">
      Saltar al contenido
    </a>

    <header class="sticky top-0 z-40 border-b-2 border-line bg-bg">
      <div class="container-page flex h-[68px] items-center justify-between gap-4">
        <a href="/" class="flex min-h-11 items-center font-display text-2xl tracking-tight uppercase">{SITE.name}</a>

        <nav aria-label="Principal" class="hidden md:block">
          <ul class="flex items-center gap-1">
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href) ? 'page' : undefined}
                  class="inline-flex min-h-11 items-center px-3 text-[15px] font-semibold uppercase decoration-2 underline-offset-8 hover:underline aria-[current=page]:underline"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-1">
          <button
            type="button"
            data-theme-toggle
            class="grid size-11 cursor-pointer place-items-center hover:bg-surface-2"
            aria-label="Cambiar a modo claro u oscuro"
          >
            <Icon name="sun" class="hidden size-5 dark:block" />
            <Icon name="moon" class="size-5 dark:hidden" />
          </button>
          <button
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="grid size-11 cursor-pointer place-items-center hover:bg-surface-2 md:hidden"
            aria-label="Abrir menú"
          >
            <Icon name="menu" class="size-5" />
          </button>
        </div>
      </div>

      <nav id="mobile-menu" aria-label="Principal" class="hidden border-t-2 border-line md:hidden">
        <ul class="container-page flex flex-col py-2">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="flex min-h-14 items-center font-display text-2xl uppercase">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-fg text-bg">
      <div class="container-page grid gap-10 py-14 md:grid-cols-[2fr_1fr_1fr]">
        <div class="max-w-md">
          <p class="font-display text-4xl uppercase">{SITE.name}</p>
          <p class="mt-4 text-sm opacity-80">
            Somos afiliados de Mercado Libre: si compras desde nuestros enlaces ganamos una comisión, sin costo
            extra para ti. Eso nunca cambia el orden ni la puntuación de los scooters. Los precios se verifican a
            mano y pueden cambiar.
          </p>
        </div>
        <nav aria-label="Secciones">
          <p class="label">Explora</p>
          <ul class="mt-2 text-sm">
            {NAV.map((item) => <li><a href={item.href} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">{item.label}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Legal">
          <p class="label">Transparencia</p>
          <ul class="mt-2 text-sm">
            <li><a href="/como-puntuamos" class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Cómo puntuamos</a></li>
            <li><a href="/como-ganamos-dinero" class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Cómo ganamos dinero</a></li>
            <li><a href="/aviso-de-privacidad" class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Aviso de privacidad</a></li>
          </ul>
        </nav>
      </div>
      <p class="container-page pb-8 text-xs opacity-70">© {new Date().getFullYear()} {SITE.name}</p>
    </footer>

    <AlertaPopup />

    <script>
      // Contador anónimo de clics en los links de afiliado con data-scooter y data-lugar (src/lib/clics.ts, /api/clic).
      // No toca la navegación: el link abre Mercado Libre tal cual y el beacon sale aparte, sin cookies ni identificadores.
      // auxclick: clic con la rueda (abre en otra pestaña), que no dispara click; el derecho (button 2) no cuenta.
      for (const tipo of ['click', 'auxclick'] as const) {
        document.addEventListener(tipo, (e) => {
          if (e.button > 1) return;
          const a = (e.target as Element).closest<HTMLAnchorElement>('a[rel~="sponsored"][data-scooter][data-lugar]');
          if (a) navigator.sendBeacon?.('/api/clic', JSON.stringify({ slug: a.dataset.scooter, lugar: a.dataset.lugar }));
        });
      }
    </script>

    <script>
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const isDark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!open));
        menuBtn.setAttribute('aria-label', open ? 'Abrir menú' : 'Cerrar menú');
        menu?.classList.toggle('hidden', open);
      });
    </script>
  </body>
</html>
