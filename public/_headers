# Cloudflare Pages: cabeceras de seguridad (docs/seguridad.md, sección 5).
# script-src lleva el hash de cada <script> inline del HTML compilado; tests/csp.spec.ts falla si no coinciden.
# /mapa: MapLibre baja estilo, tiles, sprites y fuentes de tiles.openfreemap.org (connect-src) y puede pintar
# imágenes desde blob:. Su worker se sirve desde /_astro/ (mismo origen), así que no hace falta worker-src blob:.
# Al activar Supabase, añade a connect-src: https://<proyecto>.supabase.co
# /alertas/confirmar y /alertas/dar-de-baja (enlaces de los correos): same-origin y no no-referrer, porque con
# no-referrer el POST del botón llega con Origin: null y el endpoint lo rechaza. El token va en el fragmento, que
# nunca viaja en el Referer. Cloudflare une los valores repetidos con coma y el navegador usa el último.
# Turnstile (formulario de alertas, docs/alertas.md): script-src y frame-src con https://challenges.cloudflare.com, nada más.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com 'sha256-6RfEORQjvXo61keaZZKJkb92NxsJmr9PMDVpQefQjPs=' 'sha256-b8H8Lsx+qs9xyzEoZdEP3mn4u0QtqVqeGR/gQgP1mBc=' 'sha256-3cQ2BlRm6F4erEW8bUJUbOKND+oWGDUe3xF+Gse/iMo=' 'sha256-hb7coGmHs56YD+/BglqJdamdcMYzZhZfxGfuhBjqz/0=' 'sha256-LyBAdWk2Ri5QDIrfM+zKHRexhVQ8/2KGjtQrnQmnSQY=' 'sha256-qUuK1W7vtlu88uyI2BfPZMuHn+kv3+BHRdoWswm/yPc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/alertas/confirmar/*
  Referrer-Policy: same-origin
/alertas/dar-de-baja/*
  Referrer-Policy: same-origin
