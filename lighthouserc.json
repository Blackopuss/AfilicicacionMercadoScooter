{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      },
      "autodiscoverUrlBlocklist": [
        "/admin/index.html",
        "/alertas/baja/index.html",
        "/alertas/confirmada/index.html",
        "/alertas/confirmar/index.html",
        "/alertas/dar-de-baja/index.html"
      ],
      "maxAutodiscoverUrls": 10
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
